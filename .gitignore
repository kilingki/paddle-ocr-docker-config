# Host-specific environment; keep the distributable template.
.env
.env.*
!.env.example
.envrc

# Local notes and scratch files.
/local/
*.local.md

# PaddleOCR runtime state, caches, and local model files.
/.prepare.lock
/logs/
/cache/
/models/
*.log
*.pid

# Raw validation/debug output; keep tests and benchmark summaries.
/tests/outputs/
/benchmarks/results/

# Python bytecode, virtual environments, and build artifacts.
__pycache__/
*.py[codz]
*$py.class
.venv/
venv/
env/
ENV/
build/
dist/
*.egg-info/
*.egg

# Test, coverage, and analysis caches.
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Editor and OS files.
.cursor/
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
Desktop.ini
