# Host-side Compose settings.
# MODEL_HOST_DIR is mounted at /models, as in the ASR/FA/vLLM projects.
PUBLIC_PORT=8020
MODEL_HOST_DIR=../models/ocr/tf
MODEL_PROFILE=paddleocr-vl-1.6

# Runtime overrides. Other fixed limits live in configs/common.env and the model profile.
MAX_ACTIVE_REQUESTS=1
GPU_MEMORY_UTILIZATION=0.35
ENFORCE_EAGER=true
LOAD_TIMEOUT=120
REQUEST_TIMEOUT=120
CANCEL_TIMEOUT=30
UNLOAD_TIMEOUT=30
# Optional build override to the previously verified local vLLM image:
# VLLM_BASE_IMAGE=vllm-docker-runtime:local
